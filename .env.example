# ===================================================
# City Commander Agent — 環境變數設定
# 複製此檔案為 .env 並填入你的值
# cp .env.example .env
# ===================================================

# ----- LLM 提供者 -----
# 選擇 "bedrock" 或 "gemini"
LLM_PROVIDER=gemini

# ----- Google Gemini (本地開發用) -----
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL_ID=gemini-3.5-flash

# ----- AWS Bedrock (雲端部署用) -----
# 若 LLM_PROVIDER=bedrock 才需要填
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
APP_AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514

# ----- 伺服器設定 -----
PORT=8000

# ===================================================
# 模擬時鐘 (Simulation Clock)
# 後端自己推進時間並輪播 data/ 底下的資料，
# 前端只要拉 GET /api/status 就會拿到「當下」狀態。
# 也可用 REST API 即時調整：GET/POST /api/clock
# ===================================================

# smooth   = 每 SIM_CLOCK_INTERVAL 秒走完一個資料間隔，時間連續 (預設，搭配插值最平滑)
# playback = 每 SIM_CLOCK_INTERVAL 秒「跳」到下一個資料時間點，數值階梯狀
# auto     = 連續時間，模擬時間 = 真實時間 × SIM_CLOCK_SPEED
# fixed    = 凍結在 SIM_CLOCK_START
# latest   = 永遠取資料集最後一個時間點 (舊行為)
SIM_CLOCK_MODE=smooth

# smooth / playback：每個資料間隔耗費幾秒
# (資料集裡 1 小時與 15 分鐘的間隔在畫面上耗時相同，節奏不會忽快忽慢)
SIM_CLOCK_INTERVAL=10

# auto：時間倍率 (60 = 1 真實秒 → 1 模擬分鐘)
SIM_CLOCK_SPEED=60

# 連續模式下建議前端多久抓一次 (由 /api/status 的 clock.suggested_poll_seconds 回報)
SIM_CLOCK_POLL=2

# 起始時間，留空 = 資料集第一個時間點
SIM_CLOCK_START=

# 播到資料集結尾是否從頭再播
SIM_CLOCK_LOOP=true

# 時間推進時是否主動推播到 WS /ws/dashboard
SIM_CLOCK_PUSH=true

# 資料切片語意：
#   interpolate = 在前後兩筆量測之間線性插值，數值連續變化 (預設)
#                 註：會參考「下一筆」量測，屬於重播歷史的合理做法
#   asof        = 每個路段取「<= 當下時間」的最新一筆，數值階梯狀，絕不觸碰未來資料
#   exact       = 只取單一時間點的切片
SIM_DATA_MODE=interpolate

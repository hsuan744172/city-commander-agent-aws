# ===================================================
# City Commander Agent — 環境變數設定
# 複製此檔案為 .env 並填入你的值
# cp .env.example .env
# ===================================================

# ----- LLM 提供者 -----
# 選擇 "bedrock" 或 "gemini"
LLM_PROVIDER=gemini

# ----- Google Gemini (本地開發用) -----
GEMINI_API_KEY=your-google-ai-studio-api-key-here
GEMINI_MODEL_ID=gemini-3.5-flash

# ----- AWS Bedrock (雲端部署用) -----
# 若 LLM_PROVIDER=bedrock 才需要填
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
APP_AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514

# ----- 伺服器設定 -----
PORT=8000

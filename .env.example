# City Commander Agent — local environment configuration
# Copy this file to .env. Never place permanent AWS access keys in .env or source control.

# Amazon Bedrock Claude Sonnet 4.6
# Local development: authenticate through the AWS CLI credential chain or AWS_PROFILE.
# AWS managed container service: credentials are supplied by the task or instance role.
APP_AWS_REGION=us-west-2
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
# AWS_PROFILE=city-commander-dev

# Output-token cap per Bedrock call. Latency scales with generated tokens, and
# every prompt targets <= 450 Chinese characters, so this bounds worst-case time.
BEDROCK_MAX_TOKENS=700
# Low temperature keeps repeated Demo runs close to reproducible.
BEDROCK_TEMPERATURE=0.2
# The foundation model admits about one request per second. Incidents run
# concurrently and this token bucket spaces the calls, so a multi-event batch
# stays inside the 60-second budget without exceeding the request rate.
BEDROCK_MIN_CALL_INTERVAL=1.1
INCIDENT_MAX_WORKERS=4

# Optional S3 data source for the four reference datasets:
#   city_traffic_flow.csv, signaling_crowd_density.csv,
#   road_network_geometry.json, emergency_traffic_sop.txt
# When the bucket/object cannot be read, the backend automatically falls back to
# the packaged local data/ directory, so the service keeps running.
# Incident events are NOT read from S3; they are uploaded to /api/incidents/upload.
# Use AWS_PROFILE/SSO locally and the ECS Task Role in production; never add keys here.
S3_DATA_BUCKET=
S3_DATA_PREFIX=data
S3_DATA_REFRESH_SECONDS=60

# Server
PORT=8000

# Administrator event injection (POST /api/incidents/inject)
# Empty means the endpoint is open, which keeps the local demo one step simpler.
# Set a shared secret for any shared or public deployment: injection starts agent
# runs and pushes the resulting advisory to every connected dashboard. The value
# is sent by the operator UI in the X-Admin-Token header.
INCIDENT_INJECT_TOKEN=

# Incident response v1 remains opt-in during the migration from legacy endpoints.
INCIDENT_V1_ENABLED=false

# Simulation clock
# The backend advances simulated time on its own and replays the dataset under
# data/, so the dashboard only has to fetch the current state from /api/status.
# Everything below can also be changed at runtime via GET/POST /api/clock.
#
# The clock is discrete: it only exposes timestamps that have a complete slice in
# BOTH the traffic and crowd sources, and it always snaps to that common timeline.

# playback = advance to the next common timeline slice every SIM_CLOCK_INTERVAL
#            seconds (default)
# fixed    = frozen at SIM_CLOCK_START
# latest   = always the last slice in the common timeline
# smooth   = legacy alias, now paced exactly like playback
# auto     = legacy alias, now paced exactly like playback
SIM_CLOCK_MODE=playback

# Seconds spent on each common timeline slice. Pacing is per slice, so a 1-hour
# gap and a 15-minute gap take the same wall time.
SIM_CLOCK_INTERVAL=1

# Retained for the legacy auto mode. The discrete clock ignores it.
SIM_CLOCK_SPEED=60

# Suggested dashboard polling interval while the clock is playing.
# Reported to the frontend as clock.suggested_poll_seconds.
SIM_CLOCK_POLL=1

# Starting point. Empty means the first slice in the common timeline.
SIM_CLOCK_START=

# Restart from the beginning after reaching the end of the common timeline
SIM_CLOCK_LOOP=false

# Push the current state over WS /ws/dashboard whenever simulated time advances
SIM_CLOCK_PUSH=true

# How a reading is derived for a given simulated time:
#   interpolate = linearly interpolate numeric fields between the surrounding
#                 readings (default). Note this consults the *next* reading,
#                 which is reasonable when replaying recorded history.
#   asof        = last reading at or before the current time; values step, and
#                 data after the current time is never touched
#   exact       = only the single nearest timestamp slice
SIM_DATA_MODE=interpolate

# Road segment live imagery
# Cameras are matched to segments offline by scripts/build_camera_map.py, which
# writes data/segment_cameras.json. Each camera carries two sources:
#   stream_url   Taipei City NVR Low-Latency HLS, played directly in the browser
#                (the endpoint sends access-control-allow-origin: *)
#   snapshot_url a JPEG snapshot, proxied by the backend as MJPEG at
#                /api/cameras/{segment}/{camera}/stream
# The dashboard prefers the HLS stream and only falls back to the proxy when a
# camera has no stream_url.
#
# Fallback behaviour of the snapshot proxy. The public snapshot CDN has been
# observed serving frames hours or days old, which would look frozen on screen:
#   auto = synthesise a moving scene when the snapshot is unavailable or stale
#          (default; only reachable for cameras without an HLS stream)
#   on   = always synthesise, never reach out to the snapshot source
#   off  = snapshot source only, show "no signal" when it cannot be fetched
CAMERA_MOCK=auto
